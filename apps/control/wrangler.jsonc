{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "software-factory-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../portal/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Secrets (GITHUB_WEBHOOK_SECRET, GITHUB_APP_PRIVATE_KEY, ANTHROPIC_API_KEY,
  // OPENAI_API_KEY, GITHUB_OAUTH_CLIENT_SECRET, SESSION_SECRET) are set with
  // `wrangler secret put`. Do not add `secrets.required`: a deploy must not fail before
  // the secrets exist. See docs/operations.md.
  //
  // Portal: the Worker serves /api/* itself (run_worker_first) and the portal files from
  // ../portal/dist. Security headers for those files, including the Content-Security-Policy,
  // come from apps/portal/public/_headers, which Vite copies into dist.
  "vars": {
    // Non-secret settings. RUNS_ENABLED is the global kill switch: only "true" starts
    // runs. Empty OPERATOR_IDS or PROJECTS also means no run starts.
    "GITHUB_APP_ID": "5639873",
    // Client ID of the GitHub OAuth App for portal sign-in (a different app from the GitHub
    // App above; it asks for no scopes). Empty until the OAuth App exists: login then
    // answers 503 auth_not_configured and the read API keeps working. The client secret
    // and SESSION_SECRET are secrets. See docs/operations.md.
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liX5hM3Y9qOhi6Gv",
    "RUNS_ENABLED": "true",
    "OPERATOR_IDS": "3435720",
    "PROJECTS": "roboco-io/factory-test-app,roboco-io/conveyor",
    "IMPLEMENT_MODEL": "claude-sonnet-5-5",
    "REVIEW_MODEL": "gpt-5.4-nano",
    // Stage 5: budget and engine switching. Estimated monthly spend per account (UTC
    // calendar month) and the most one run may spend on one account, in USD. When Anthropic
    // reached its limit pi implements with FALLBACK_IMPLEMENT_MODEL; ANTHROPIC_REVIEW_MODEL
    // reviews on Anthropic. When both reached it, new runs stop and one issue per period goes
    // to FACTORY_REPO (the GitHub App needs Issues write there). See docs/operations.md.
    "BUDGET_ANTHROPIC_USD": "5",
    "BUDGET_OPENAI_USD": "5",
    "RUN_BUDGET_USD": "5",
    "FALLBACK_IMPLEMENT_MODEL": "gpt-6.1-terra",
    "ANTHROPIC_REVIEW_MODEL": "claude-haiku-5-5",
    "FACTORY_REPO": "roboco-io/the-software-factory-demo",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "software-factory",
      "database_id": "db03024c-4138-4425-a518-472af3a56aea",
      "migrations_dir": "migrations",
    },
  ],
  "containers": [
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "agent": { "dockerfile": "./container/Dockerfile" },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "IssueRun", "name": "ISSUE_RUN" },
      { "class_name": "AgentSandbox", "name": "SANDBOX" },
    ],
  },
  "exports": {
    "IssueRun": { "type": "durable-object", "storage": "sqlite" },
    "AgentSandbox": { "type": "durable-object", "storage": "sqlite" },
  },
}
