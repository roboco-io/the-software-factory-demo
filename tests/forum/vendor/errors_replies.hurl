HTTP 422
[Asserts]
jsonpath "$.errors.body[0]" == "is too long (maximum is 5000 characters)"

# 다른 토론의 답글을 부모로 지정
POST {{host}}/api/topics/{{topic_id}}/replies
Authorization: Token {{token_a}}
{
  "reply": { "body": "본문", "parentId": {{other_reply_id}} }
}
HTTP 422
[Asserts]
jsonpath "$.errors.parentId[0]" == "is invalid"

# 없는 부모
POST {{host}}/api/topics/{{topic_id}}/replies
Authorization: Token {{token_a}}
{
  "reply": { "body": "본문", "parentId": 999999999 }
}
HTTP 422
[Asserts]
jsonpath "$.errors.parentId[0]" == "is invalid"

# 없는 토론
POST {{host}}/api/topics/999999999/replies
Authorization: Token {{token_a}}
{
  "reply": { "body": "본문" }
}
HTTP 404
[Asserts]
jsonpath "$.errors.topic[0]" == "not found"

# 남의 답글 수정·삭제
PUT {{host}}/api/replies/{{other_reply_id}}
Authorization: Token {{token_b}}
{
  "reply": { "body": "가로채기" }
}
HTTP 403
[Asserts]
jsonpath "$.errors.reply[0]" == "forbidden"

DELETE {{host}}/api/replies/{{other_reply_id}}
Authorization: Token {{token_b}}
HTTP 403
[Asserts]
jsonpath "$.errors.reply[0]" == "forbidden"

# 없는 답글
PUT {{host}}/api/replies/999999999
Authorization: Token {{token_a}}
{
  "reply": { "body": "없음" }
}
HTTP 404
[Asserts]
jsonpath "$.errors.reply[0]" == "not found"
