# Setup: 두 사용자
POST {{host}}/api/users
{
  "user": { "username": "eta_{{uid}}", "email": "eta_{{uid}}@test.com", "password": "password123" }
}
HTTP 201
[Captures]
token_a: jsonpath "$.user.token"

POST {{host}}/api/users
{
  "user": { "username": "etb_{{uid}}", "email": "etb_{{uid}}@test.com", "password": "password123" }
}
HTTP 201
[Captures]
token_b: jsonpath "$.user.token"

# 인증 필요
POST {{host}}/api/topics
{
  "topic": { "title": "익명", "body": "본문" }
}
HTTP 401

# 제목 필수
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "", "body": "본문" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.title[0]" == "can't be blank"

# 본문 필수
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "제목" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.body[0]" == "can't be blank"

# 제목 200자 초과
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가", "body": "본문" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.title[0]" == "is too long (maximum is 200 characters)"

# 본문 20000자 초과
POST {{host}}/api/topics
Authorization: Token {{token_a}}
