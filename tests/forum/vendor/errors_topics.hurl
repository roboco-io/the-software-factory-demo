  "topic": { "title": "제목", "body": "본문", "kind": "rant" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.kind[0]" == "is invalid"

# 없는 문서
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "제목", "body": "본문", "docId": "ch99" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.docId[0]" == "is invalid"

# 문서에 없는 앵커
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "제목", "body": "본문", "docId": "ch01", "anchor": "s09" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.anchor[0]" == "is invalid"

# 앵커만 있고 문서가 없음
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "제목", "body": "본문", "anchor": "s01" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.docId[0]" == "can't be blank"

# 남의 토론 수정·삭제
POST {{host}}/api/topics
Authorization: Token {{token_a}}
{
  "topic": { "title": "권한 시험 {{uid}}", "body": "본문" }
}
HTTP 201
[Captures]
topic_id: jsonpath "$.topic.id"

PUT {{host}}/api/topics/{{topic_id}}
Authorization: Token {{token_b}}
{
  "topic": { "title": "가로채기" }
}
HTTP 403
[Asserts]
jsonpath "$.errors.topic[0]" == "forbidden"

DELETE {{host}}/api/topics/{{topic_id}}
Authorization: Token {{token_b}}
HTTP 403
[Asserts]
jsonpath "$.errors.topic[0]" == "forbidden"

# 수정에서도 같은 검증
PUT {{host}}/api/topics/{{topic_id}}
Authorization: Token {{token_a}}
{
  "topic": { "title": "" }
}
HTTP 422
[Asserts]
jsonpath "$.errors.title[0]" == "can't be blank"

# 없는 토론
GET {{host}}/api/topics/999999999
HTTP 404
[Asserts]
jsonpath "$.errors.topic[0]" == "not found"

PUT {{host}}/api/topics/999999999
Authorization: Token {{token_a}}
{
  "topic": { "title": "없음" }
}
HTTP 404
